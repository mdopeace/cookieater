{
  "name": "cookieater",
  "description": "A friendly cookie editor browser extension",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "compile:e2e": "tsc -p tsconfig.e2e.json --noEmit",
    "test:e2e": "pnpm build && playwright test",
    "test:e2e:run": "playwright test"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.2.10",
    "@fontsource/nunito": "^5.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/auto-icons": "^1.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wxt": "^0.20.27"
  }
}
